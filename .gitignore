# ── 环境变量：含 API Key，绝不能提交 ──
.env
.env.*
!.env.example

# ── 本地数据：含用户名与密码哈希，绝不能提交 ──
apps/api/data/

# ── 依赖 ──
node_modules/
.pnpm-store/

# ── 构建产物 ──
dist/
build/
out/
*.tsbuildinfo

# ── 测试与覆盖率 ──
coverage/

# ── 日志 ──
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── 编辑器与系统 ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ── Claude Code 个人本地设置（团队共享配置走 .claude/settings.json） ──
.claude/settings.local.json

# Claude Code worktrees（本地工作区，不纳入版本控制）
.claude/worktrees/

# superpowers 执行计划的本地工作区（ledger、brief、review 包，均为临时产物）
.superpowers/

# ── 工具缓存 ──
# codegraph 索引缓存，由工具自行重建
.codegraph/

# ── 本地素材：非知识库源文件，不入库 ──
# 知识库正文是 Markdown / YAML（packages/knowledge/*.md 与 questions/*.yaml）；
# 这些是派生出来的分享件与参考文档，体积大且为二进制，留在本地
packages/knowledge/questions/生涯规划测评题目/
packages/knowledge/questions/.trae-html-share-packages/
docs/*.docx
