# ── 环境变量：含 API Key，绝不能提交 ──
.env
.env.*
!.env.example

# ── 依赖 ──
node_modules/
.pnpm-store/

# ── 构建产物 ──
dist/
build/
out/
*.tsbuildinfo

# ── 测试与覆盖率 ──
coverage/

# ── 日志 ──
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── 编辑器与系统 ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

